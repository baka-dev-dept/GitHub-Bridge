    <ClCompile Include="..\GitHub-Bridge\src\platform\windows\WinHttpTransport.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\platform\windows\WindowsPlatform.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\platform\windows\DpapiVault.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\Security\PermissionManager.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\Core\ToolRegistry.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\Cache\CacheManager.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\Security\TokenManager.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\Security\TokenStorage.cpp" />
    <ClCompile Include="..\GitHub-Bridge\src\Utils\Logger.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
