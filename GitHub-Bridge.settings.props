<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    全工程共享配置。输�?中间目录按平台、配置分目录，避�?obj 互相覆盖�?    源文件与执行字符集统一 UTF-8：本机系统代码页�?GBK，不显式声明会把中文字面量编错�?  -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)$(Platform)\out\$(ProjectName)\$(Configuration)\</IntDir>
    <SourceCharset>utf-8</SourceCharset>
    <ExecutionCharset>utf-8</ExecutionCharset>
    <VcpkgEnabled>false</VcpkgEnabled>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(SolutionDir)GitHub-Bridge\include;$(SolutionDir)GitHub-Bridge\third_party;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 第三方头文件不是本工程的代码，不参与 SDL �?4 级警告清�?-->
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
    </ClCompile>
    <Link>
      <AdditionalDependencies>winhttp.lib;crypt32.lib;advapi32.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
